{
  "openapi": "3.0.3",
  "info": {
    "title": "Nujek Partner API",
    "version": "1.0.0",
    "description": "Partner API Nujek. Semua request membutuhkan X-Client-Key, X-Timestamp, X-Nonce, dan X-Signature HMAC-SHA256. Import file ini ke Postman, lalu isi variable baseUrl, clientKey, clientSecret, dan webhookSecret bila diperlukan."
  },
  "servers": [
    { "url": "{{baseUrl}}", "description": "URL server example lokal" }
  ],
  "tags": [
    { "name": "Customers" },
    { "name": "Pricing" },
    { "name": "Routing" },
    { "name": "Orders" }
  ],
  "paths": {
    "/api/client/register": {
      "post": {
        "tags": ["Customers"],
        "summary": "Register customer",
        "operationId": "registerCustomer",
        "parameters": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" }, "example": { "name": "Budi Santoso", "email": "budi@example.com", "phone": "081234567890" } } } },
        "responses": { "200": { "description": "Customer berhasil didaftarkan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResponse" } } } }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/api/client/pricing/preview": {
      "get": {
        "tags": ["Pricing"],
        "summary": "Preview harga",
        "operationId": "pricingPreview",
        "parameters": [
          { "name": "service_id", "in": "query", "required": true, "schema": { "type": "integer", "enum": [1, 2] }, "example": 1 },
          { "name": "sub_service_id", "in": "query", "schema": { "type": "integer" }, "example": 1 },
          { "name": "regency_id", "in": "query", "schema": { "type": "string" }, "example": "7171" },
          { "name": "regency_name", "in": "query", "schema": { "type": "string" }, "example": "Kota Manado" },
          { "name": "distance_km", "in": "query", "schema": { "type": "number", "format": "double", "minimum": 0 }, "example": 5.5 },
          { "name": "is_simple", "in": "query", "schema": { "type": "boolean" }, "example": false },
          { "name": "latitude", "in": "query", "schema": { "type": "number", "format": "double" } },
          { "name": "longitude", "in": "query", "schema": { "type": "number", "format": "double" } }
        ],
        "responses": { "200": { "description": "Estimasi harga", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericResponse" } } } }, "422": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/api/client/routing/distance": {
      "post": {
        "tags": ["Routing"],
        "summary": "Calculate route distance",
        "operationId": "routingDistance",
        "parameters": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoutingRequest" }, "example": { "mode": "motorcycle", "routes": [{ "latitude": -7.250445, "longitude": 112.768845 }, { "latitude": -7.26, "longitude": 112.78 }] } } } },
        "responses": { "200": { "description": "Jarak routing", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoutingResponse" } } } }, "422": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/api/client/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create order",
        "operationId": "createOrder",
        "parameters": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrderRequest" }, "example": { "customer_uuid": "24a55c29-5be8-4381-b915-3d658685a5a8", "client_request_id": "11111111-1111-4111-8111-111111111111", "service_id": 1, "sub_service_id": 1, "payment_method_id": 1, "regency_id": "7171", "routes": [{ "latitude": -7.250445, "longitude": 112.768845 }, { "latitude": -7.26, "longitude": 112.78 }] } } } },
        "responses": { "200": { "description": "Order berhasil dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericResponse" } } } }, "409": { "$ref": "#/components/responses/Conflict" }, "422": { "$ref": "#/components/responses/ValidationError" } }
      }
    },
    "/api/client/orders/{order_uuid}/cancel": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cancel order",
        "operationId": "cancelOrder",
        "parameters": [{ "$ref": "#/components/parameters/OrderUUID" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelRequest" }, "example": { "reason": "Customer membatalkan order" } } } },
        "responses": { "200": { "description": "Order berhasil dibatalkan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/client/orders/{order_uuid}/review-driver": {
      "post": {
        "tags": ["Orders"],
        "summary": "Review driver",
        "operationId": "reviewDriver",
        "parameters": [{ "$ref": "#/components/parameters/OrderUUID" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" }, "example": { "rating": 5, "comment": "Pelayanan baik" } } } },
        "responses": { "200": { "description": "Review berhasil", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericResponse" } } } }, "404": { "$ref": "#/components/responses/NotFound" }, "422": { "$ref": "#/components/responses/ValidationError" } }
      }
    }
  },
  "components": {
    "parameters": {
      "OrderUUID": { "name": "order_uuid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "schemas": {
      "RegisterRequest": { "type": "object", "required": ["name", "email", "phone"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 150 }, "email": { "type": "string", "format": "email" }, "phone": { "type": "string", "minLength": 8, "maxLength": 20 } } },
      "RegisterResponse": { "type": "object", "properties": { "data": { "type": "object", "properties": { "uuid": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "email": { "type": "string" }, "phone": { "type": "string" } } }, "message": { "type": "string" } } },
      "RoutingRequest": { "type": "object", "required": ["mode", "routes"], "properties": { "mode": { "type": "string", "enum": ["motorcycle", "drive"] }, "routes": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/components/schemas/Waypoint" } } } },
      "Waypoint": { "type": "object", "required": ["latitude", "longitude"], "properties": { "latitude": { "type": "number", "format": "double", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "format": "double", "minimum": -180, "maximum": 180 }, "address": { "type": "string" }, "note": { "type": "string" } } },
      "RoutingResponse": { "type": "object", "properties": { "data": { "type": "object", "properties": { "distance_meters": { "type": "integer" }, "duration_seconds": { "type": "integer" }, "provider": { "type": "string" }, "mode": { "type": "string" }, "legs": { "type": "array", "items": { "type": "object" } } } }, "message": { "type": "string" } } },
      "CreateOrderRequest": { "type": "object", "required": ["customer_uuid", "client_request_id", "service_id", "sub_service_id", "payment_method_id", "regency_id", "routes"], "properties": { "customer_uuid": { "type": "string", "format": "uuid" }, "client_request_id": { "type": "string", "format": "uuid" }, "service_id": { "type": "integer", "enum": [1, 2] }, "sub_service_id": { "type": "integer" }, "payment_method_id": { "type": "integer" }, "regency_id": { "type": "string" }, "driver_uuid": { "type": "string", "format": "uuid" }, "merchant_uuid": { "type": "string", "format": "uuid" }, "routes": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/components/schemas/Waypoint" } }, "items": { "type": "array", "items": { "type": "object" } }, "voucher_code": { "type": "string" }, "delivery_detail": { "type": "object" } } },
      "CancelRequest": { "type": "object", "properties": { "reason": { "type": "string" } } },
      "ReviewRequest": { "type": "object", "required": ["rating"], "properties": { "rating": { "type": "integer", "minimum": 1, "maximum": 5 }, "comment": { "type": "string", "maxLength": 500 } } },
      "GenericResponse": { "type": "object", "properties": { "data": {}, "message": { "type": "string" } } },
      "MessageResponse": { "type": "object", "properties": { "message": { "type": "string" } } }
    },
    "responses": {
      "ValidationError": { "description": "Payload tidak valid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
      "Conflict": { "description": "Data sudah ada atau request duplikat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
      "NotFound": { "description": "Resource tidak ditemukan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } }
    }
  }
}
