# =========================================
# Partner API upstream (WAJIB)
# =========================================
# URL server backend yang menyediakan /api/client.
# Jangan menambahkan suffix /api/client di sini.
CLIENT_API_BASE_URL=https://staging-api.example.com

# Credentials yang dibuat dari halaman admin Client API.
CLIENT_API_KEY=replace-with-client-api-key
CLIENT_API_SECRET=replace-with-client-api-secret

# =========================================
# HTTP server example (OPSIONAL)
# =========================================
# Port lokal yang dibuka untuk Postman.
EXAMPLE_PORT=8088

# =========================================
# Catatan penggunaan
# =========================================
# Request register, pricing, routing, dan order dikirim melalui Postman.
# Body request tidak disimpan di environment agar mudah diganti per request.
#
# Register:
# POST http://localhost:${EXAMPLE_PORT}/register
# {"name":"Budi Santoso","email":"budi@example.com","phone":"081234567890"}
#
# Pricing:
# GET http://localhost:${EXAMPLE_PORT}/pricing/preview?service_id=1&sub_service_id=1&regency_id=7171&distance_km=5.5
